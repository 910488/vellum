node_modules/
dist/
src-tauri/target/
# Scratch space for probe runs, app-server schema dumps and eval runtimes.
# Was only ignored one subdirectory deep, so ~768 generated files were showing
# up as untracked.
target/
src-tauri/gen/
*.local
.DS_Store
__pycache__/
logs/
artifacts/
issue*_body.json
issue*_body.md
issue*_raw.txt

# Local credentials and machine-specific configuration. Commit only redacted
# `.example` fixtures with synthetic values.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
auth.json
credentials.json
secrets.json
.npmrc
.pypirc

# Isolated Jetson live-smoke local artifacts
target/live-smoke/

# Generated by scripts/build-local-release.ps1 and embedded into NSIS.
src-tauri/resources/remote/manifest.json
src-tauri/resources/remote/linux-amd64/
src-tauri/resources/remote/linux-arm64/

# QA reports contain machine paths and remain local. Commit only reviewed,
# manually de-identified Markdown summaries.
qa/reports/generated/
qa/runs/
qa/reports/**/*.json
qa/reports/**/*.html

# Local worktrees and package manager cache
.worktrees/
.pnpm-store/

# Staged App Server bridge sidecar (scripts/build-sidecar.mjs); built per release.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
