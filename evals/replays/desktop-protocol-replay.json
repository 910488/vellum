    {
      "id": "chat-glm-preserves-namespace-for-fetch-helpers",
      "operation": "prepare_compatible_chat",
      "model": "GLM-5.2",
      "input": {
        "model": "vlm-glm",
        "input": [
          {
            "type": "message",
            "role": "user",
            "content": "continue"
          }
        ],
        "tools": [
          {
            "type": "namespace",
            "name": "codex_app",
            "tools": [
              {
                "type": "function",
                "name": "_fetch",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "request"
                  ]
                }
              }
            ]
          },
          {
            "type": "namespace",
            "name": "plugin_management",
            "tools": [
              {
                "type": "function",
                "name": "_fetch",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "cursor": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cursor"
                  ]
                }
              }
            ]
          },
          {
            "type": "custom",
            "name": "_fetch"
          }
        ]
      },
      "expected": {
        "/model": "GLM-5.2",
        "/tools/0/function/name": "codex_app___fetch",
        "/tools/1/function/name": "plugin_management___fetch",
        "/tools/2/function/name": "_fetch",
        "/tools/2/function/parameters/required/0": "input"
      }
    },
    {
