{
  "cases": [
    {
      "id": "zstd-body-is-rebuilt-as-json",
      "operation": "zstd_rebuild",
      "input": {
        "model": "vlm-compatible",
        "input": [
          {
            "role": "user",
            "content": "hello"
          }
        ]
      },
      "expected": {
        "/body/model": "vlm-compatible",
        "/contentEncodingForwarded": false,
        "/contentType": "application/json"
      }
    },
    {
      "id": "grok-deduplicates-exec",
      "operation": "prepare_grok",
      "model": "grok-4.5",
      "input": {
        "model": "vlm-grok",
        "input": [
          {
            "type": "additional_tools",
            "tools": [
              {
                "type": "function",
                "name": "exec",
                "parameters": {
                  "type": "object"
                }
              }
            ]
          },
          {
            "role": "user",
            "content": "run"
          }
        ],
        "tools": [
          {
            "type": "function",
            "name": "exec",
            "parameters": {
              "type": "object"
            }
          }
        ]
      },
      "expected": {
        "/model": "grok-4.5",
        "/tools/0/name": "exec"
      },
      "absent": [
        "/tools/1",
        "/additional_tools"
      ]
    },
    {
