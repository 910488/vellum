    {
      "id": "vellum-synthetic-reasoning-is-removed-from-full-official-snapshot",
      "operation": "prepare_official_handoff",
      "model": "gpt-5.4-mini",
      "input": {
        "model": "vlm-official",
        "input": [
          {
            "type": "reasoning",
            "id": "resp_vellum_1786621788663_reasoning",
            "summary": [{"type": "summary_text", "text": "foreign reasoning"}]
          },
          {
            "type": "message",
            "id": "resp_vellum_1786621788663_message",
            "role": "assistant",
            "content": [{"type": "output_text", "text": "visible answer"}]
          },
          {"role": "user", "content": "continue with GPT"}
        ]
      },
      "expected": {
        "/model": "gpt-5.4-mini",
        "/input/0/content/0/text": "visible answer",
        "/input/1/content": "continue with GPT"
      },
      "expectedPrefixes": {
        "/input/0/id": "msg_"
      },
      "absent": ["/input/2"]
    },
