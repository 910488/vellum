    {
      "id": "compatible-fetch-prefers-custom-over-generated-wrapper",
      "operation": "prepare_compatible",
      "model": "GLM-5.2",
      "input": {
        "model": "vlm-glm",
        "input": [
          {
            "type": "message",
            "role": "user",
            "content": "continue"
          }
        ],
        "tools": [
          {
            "type": "function",
            "name": "_fetch",
            "description": "Generated compatibility wrapper",
            "parameters": {
              "type": "object",
              "properties": {
                "request": {
                  "type": "string"
                }
              },
              "required": [
                "request"
              ]
            }
          },
          {
            "type": "custom",
            "name": "_fetch",
            "description": "Current Codex fetch tool"
          }
        ]
      },
      "expected": {
        "/model": "GLM-5.2",
        "/tools/0/name": "_fetch",
        "/tools/0/parameters/required/0": "input"
      },
      "absent": [
        "/tools/1",
        "/tools/0/parameters/properties/request"
      ]
    },
