FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.142.5

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 python-is-python3 socat \
    && npm install --global "@openai/codex@${CODEX_VERSION}" \
    && useradd --create-home --uid 10001 --shell /bin/bash eval \
    && rm -rf /var/lib/apt/lists/*

USER eval
WORKDIR /workspace
ENV CODEX_HOME=/codex-home
ENV PYTHONUTF8=1
ENTRYPOINT ["codex"]
